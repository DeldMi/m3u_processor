# ========================================================
# CONFIGURACOES DE PROCESSAMENTO E CONECTIVIDADE
# ========================================================
MAX_CHANNELS_PER_FILE='400'
CONCURRENCY_LIMIT='50'
REQUEST_TIMEOUT='6'
USER_AGENT='VLC/3.0.18 LibVLC/3.0.18'

# ========================================================
# FONTES REMOTAS (URLs separadas por ponto e virgula ;)
# ========================================================
REMOTE_M3U_URLS=''
EPG_URLS='https://iptv-epg.org/files/brazil.xml.gz'

# ========================================================
# AUTOMACAO E AGENDAMENTO (SCHEDULE)
# Modos validos: DISABLED, INTERVAL ou CRON
# ========================================================
SCHEDULE_MODE='DISABLED'
SCHEDULE_INTERVAL_HOURS=12
SCHEDULE_CRON_TIME=03:00
HEALTH_CHECK_INTERVAL_SECONDS=60
INTERNET_TEST_TARGET=1.1.1.1
INTERNET_PING_INTERVAL_SECONDS=5
INTERNET_PING_TIMEOUT_SECONDS=2
AUTO_UPDATE_XTEVE=0
NUMBER_OF_TUNERS=1
EPG_SOURCE=XEPG
API_INTERFACE_ENABLED=1
FILE_UPDATE_SCHEDULE=
UPDATE_FILES_ON_STARTUP=0
TEMP_FILES_LOCATION=
IMAGE_CACHING=1
REPLACE_MISSING_PROGRAM_IMAGES=1
STREAM_BUFFER_ENABLED=0
UDPPROXY_ADDRESS=
BUFFER_SIZE_MB=32
CLIENT_CONNECTION_TIMEOUT_MS=5000
FFMPEG_BINARY_PATH=
FFMPEG_OPTIONS=
VLC_BINARY_PATH=
VLC_OPTIONS=
BACKUP_LOCATION=
BACKUPS_TO_KEEP=5
WEB_AUTHENTICATION=1
BACKEND_ORIGIN=

# ========================================================
# SERVIDOR WEB
# ========================================================
WEB_HOST=127.0.0.1
WEB_PORT=5000
BASE_URL=http://127.0.0.1:5000
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
API_TOKEN=''
ALLOW_INSECURE_TLS=0
# O setup gera uma senha aleatoria se ficar vazio.
ADMIN_INITIAL_PASSWORD=''
# ConfigManager gera automaticamente uma chave persistente se ficar vazio.
SECRET_KEY=''
